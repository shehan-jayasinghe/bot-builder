{
  "name": "bot-builder-cloudflare",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "cf:inject": "node scripts/inject-wrangler-config.mjs",
    "preview": "npm run cf:inject && opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "node scripts/inject-wrangler-config.mjs --strict && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 execute bot-builder --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute bot-builder --remote --file=./schema.sql"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.6.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.20.0"
  }
}
