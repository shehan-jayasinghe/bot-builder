APP_NAME=bot-builder
DEBUG=true
HOST=0.0.0.0
PORT=8000

MONGO_URI=mongodb://localhost:27017
MONGO_DB=bot_builder

AWS_REGION=us-east-1
# Chat model — used when creating new agents (stored on agent.llm_config)
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# Embeddings model — knowledge base / RAG only (not for chat)
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0

# LangSmith — LLM trace observability (preview + webhook chat)
# Enable to send one parent run per chat turn (turn_id + agent_id + sender_id)
# with nested LLM/tool child runs to https://smith.langchain.com
# Get API key: https://smith.langchain.com/settings
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=bot-builder
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# NeMo Guardrails — intent + output self-check (off by default; requires AWS creds for Bedrock Haiku)
# NEMO_GUARDRAILS_ENABLED=false
# NEMO_CONFIG_PATH=config/nemo/profiles/default

# RAG evaluation (RAGAS) — on-demand eval API for builder preview
# RAG_EVAL_ENABLED=false
# RAG_EVAL_FAITHFULNESS_THRESHOLD=0.8
# RAG_EVAL_CONTEXT_PRECISION_THRESHOLD=0.7
# Optional judge model override (defaults to BEDROCK_MODEL_ID)
# RAG_EVAL_JUDGE_MODEL_ID=amazon.nova-lite-v1:0

CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_ISSUER=https://your-app.clerk.accounts.dev
CLERK_JWKS_URL=https://your-app.clerk.accounts.dev/.well-known/jwks.json
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
