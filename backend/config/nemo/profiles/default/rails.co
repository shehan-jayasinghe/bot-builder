# Dialog rails — scripted replies without main orchestrator LLM (Phase 0+)

define user express greeting
  "hello"
  "hi"
  "hey"
  "good morning"
  "good afternoon"

define bot express greeting
  "Hello! How can I help you with your account or payments today?"

define flow greeting
  user express greeting
  bot express greeting

define user ask help
  "help"
  "what can you do"
  "how can you help"

define bot offer help
  "I can help with payment reminders, account questions, and guided workflows. What do you need?"

define flow help
  user ask help
  bot offer help

define user express goodbye
  "bye"
  "goodbye"
  "see you"

define bot express goodbye
  "Goodbye! Reach out anytime if you need help with your account."

define flow goodbye
  user express goodbye
  bot express goodbye
